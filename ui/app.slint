import "./fonts/Nunito-Regular.ttf";
import "./fonts/Nunito-Bold.ttf";

global Palette {
    out property <color> gray-900: #111827;
    out property <color> gray-800: #1f2937;
    out property <color> gray-700: #374151;
    out property <color> gray-600: #4b5563;
    out property <color> gray-500: #6b7280;
    out property <color> gray-400: #9ca3af;
    out property <color> red-400: #f87171;
    out property <color> cyan-400: #22d3ee;
    out property <color> lime-500: #84cc16;
    out property <color> lime-800: #3f6212;
    out property <color> rose-500: #f43f5e;
    out property <color> rose-800: #9f1239;
    out property <color> sky-200: #bae6fd;
    out property <color> input: #6b72801a;
}

export struct DeviceRow {
    name: string,
    address: string,
    selected: bool,
}

component Heart inherits Path {
    viewbox-width: 24;
    viewbox-height: 24;
    commands: "m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z";
}

component Label inherits Text {
    font-size: 14px;
    height: 12px;
    vertical-alignment: center;
    color: white;
}

component Field inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> number;
    callback edited(string);
    height: 24px;
    border-radius: 2px;
    background: Palette.input;
    if root.text == "": placeholder-label := Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        vertical-alignment: center;
        font-size: 14px;
        color: Palette.gray-600;
        text: root.placeholder;
    }
    input := TextInput {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        vertical-alignment: center;
        font-size: 14px;
        color: Palette.gray-400;
        single-line: true;
        selection-background-color: #22d3ee55;
        input-type: root.number ? InputType.number : InputType.text;
        text <=> root.text;
        edited => {
            root.edited(self.text);
        }
    }
}

component SmallButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();
    height: 28px;
    border-radius: 6px;
    background: touch.has-hover && root.enabled ? Palette.gray-700 : Palette.gray-800;
    label := Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        vertical-alignment: center;
        horizontal-alignment: center;
        text: root.text;
        color: !root.enabled ? Palette.gray-500 : root.active || touch.has-hover ? Palette.cyan-400 : white;
    }
    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}

component Check inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    height: 20px;
    box := Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 3px;
        border-width: root.checked ? 0 : 1px;
        border-color: Palette.gray-500;
        background: root.checked ? Palette.cyan-400 : Palette.input;
        if root.checked: Path {
            width: 10px;
            height: 10px;
            x: 2px;
            y: 2px;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: "M1.5 5.2 L4 7.6 L8.6 2.4";
            stroke: Palette.gray-900;
            stroke-width: 1.8px;
        }
    }
    caption := Text {
        x: 22px;
        width: parent.width - 22px;
        height: parent.height;
        vertical-alignment: center;
        font-size: 14px;
        text: root.text;
        color: white;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component Select inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    callback picked(int);
    height: 24px;
    border-radius: 2px;
    background: Palette.input;
    value := Text {
        x: 8px;
        width: parent.width - 28px;
        height: parent.height;
        vertical-alignment: center;
        font-size: 14px;
        color: Palette.gray-400;
        text: root.options[root.current];
        overflow: elide;
    }
    Path {
        x: parent.width - 18px;
        y: (parent.height - 6px) / 2;
        width: 10px;
        height: 6px;
        viewbox-width: 10;
        viewbox-height: 6;
        commands: "M1 1 L5 5 L9 1";
        stroke: Palette.gray-400;
        stroke-width: 1.5px;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            popup.show();
        }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;
        Rectangle {
            background: Palette.gray-800;
            border-radius: 4px;
            border-width: 1px;
            border-color: Palette.gray-700;
            VerticalLayout {
                padding: 2px;
                for option[index] in root.options: Rectangle {
                    height: 22px;
                    border-radius: 2px;
                    background: row-touch.has-hover ? Palette.gray-700 : transparent;
                    option-label := Text {
                        x: 6px;
                        width: parent.width - 12px;
                        height: parent.height;
                        vertical-alignment: center;
                        font-size: 14px;
                        text: option;
                        color: index == root.current ? Palette.cyan-400 : Palette.gray-400;
                    }
                    row-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current = index;
                            root.picked(index);
                        }
                    }
                }
            }
        }
    }
}

component Link inherits Rectangle {
    in property <string> text;
    callback clicked();
    width: label.preferred-width;
    height: 20px;
    label := Text {
        x: 0;
        height: parent.height;
        vertical-alignment: center;
        font-size: 14px;
        color: Palette.sky-200;
        text: root.text;
    }
    Rectangle {
        x: 0;
        y: 16px;
        width: label.width;
        height: 1px;
        background: Palette.sky-200;
    }
    TouchArea {
        x: 0;
        width: label.width;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    width: label.preferred-width;
    height: 26px;
    label := Text {
        y: 0;
        height: 24px;
        vertical-alignment: center;
        text: root.text;
        color: white;
    }
    if root.active: Rectangle {
        y: 24px;
        height: 2px;
        background: Palette.cyan-400;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Home inherits Rectangle {
    in property <bool> connected;
    in property <int> bpm;
    in property <string> percent-text;
    in property <string> status;
    in property <bool> animate: true;
    property <length> heart-top: 21px;
    property <float> t: root.connected && root.visible && root.animate ? mod(animation-tick() / 1ms, 1000) / 1000 : 1;
    property <float> p: min(1, root.t / 0.75);
    property <float> eased: 1 - pow(1 - root.p, 3);
    if root.connected: Heart {
        width: 56px * (1 + root.eased);
        height: self.width;
        x: (root.width - self.width) / 2;
        y: root.heart-top + 28px - self.height / 2;
        fill: Palette.red-400;
        opacity: 0.7 * (1 - root.eased);
    }
    heart := Heart {
        x: (root.width - 56px) / 2;
        y: root.heart-top;
        width: 56px;
        height: 56px;
        fill: root.connected ? Palette.red-400 : Palette.gray-500;
    }
    bpm-label := Text {
        y: root.heart-top + 56px + 11px;
        width: root.width;
        height: 28px;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 20px;
        text: root.bpm + " bpm";
        color: root.connected ? Palette.red-400 : Palette.gray-500;
    }
    percent-label := Text {
        y: root.heart-top + 56px + 11px + 28px;
        width: root.width;
        height: 20px;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 14px;
        text: "(" + root.percent-text + ")";
        color: Palette.gray-600;
    }
    status-title := Text {
        y: 157px;
        width: root.width;
        height: 20px;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 14px;
        text: "Connection Status";
        color: white;
    }
    status-value := Text {
        y: 177px;
        width: root.width;
        height: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 12px;
        text: root.connected ? "Connected" : "Disconnected";
        color: root.connected ? Palette.lime-500 : Palette.gray-600;
    }
    source-label := Text {
        y: 193px;
        x: 8px;
        width: root.width - 16px;
        height: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 12px;
        text: root.status;
        color: Palette.gray-500;
        overflow: elide;
    }
}

export component VrPanel inherits Window {
    width: 325px;
    height: 250px;
    background: Palette.gray-900;
    default-font-family: "Nunito";
    default-font-size: 16px;
    in property <bool> connected;
    in property <int> bpm;
    in property <string> percent-text: "0.00";
    in property <string> status;
    panel-title := Text {
        x: 8px;
        y: 8px;
        height: 24px;
        vertical-alignment: center;
        text: "hr-osc-rust";
        color: white;
    }
    Home {
        x: 8px;
        y: 38px;
        width: 309px;
        height: 204px;
        animate: false;
        connected: root.connected;
        bpm: root.bpm;
        percent-text: root.percent-text;
        status: root.status;
    }
}

export component AppWindow inherits Window {
    title: "hr-osc-rust";
    icon: root.beat ? @image-url("../assets/icon-beat.png") : @image-url("../assets/icon.png");
    width: 325px;
    height: 250px;
    background: Palette.gray-900;
    default-font-family: "Nunito";
    default-font-size: 16px;

    in-out property <int> page: 0;
    in-out property <string> tab: "general";

    in property <bool> connected;
    in property <bool> beat;
    in property <int> bpm;
    in property <string> percent-text: "0.00";
    in property <string> status;
    in property <[DeviceRow]> devices;
    in property <string> notice;
    in property <string> version;

    in property <[string]> services;
    in-out property <int> service;
    in-out property <string> connected-timeout;
    in-out property <bool> autostart;
    in-out property <bool> check-updates;
    in-out property <bool> steamvr;
    in property <bool> steamvr-supported;
    in-out property <string> http-port;
    in-out property <string> widget-id;
    in-out property <string> osc-host;
    in-out property <string> osc-port;
    in-out property <string> path-connected;
    in-out property <string> path-percent;
    in-out property <string> max-heart-rate;
    in-out property <string> pico-strap;

    in property <bool> update-shown;
    in property <string> update-version;
    in property <string> update-state;
    in property <bool> update-busy;

    callback setting(string, string);
    callback service-picked(int);
    callback autostart-toggled(bool);
    callback updates-toggled(bool);
    callback steamvr-toggled(bool);
    callback steamvr-registered(bool);
    callback device-picked(string);
    callback restart-source();
    callback install-firmware();
    callback open-link(string);
    callback update-now();
    callback update-later();
    callback update-skip();

    property <bool> show-bluetooth: root.service == 0 || root.service == 1;
    property <bool> show-pico: root.service == 0 || root.service == 2;
    property <bool> show-http: root.service == 3;
    property <bool> show-pulsoid: root.service == 4;

    if root.update-shown: Rectangle {
        Rectangle {
            width: 220px;
            height: 150px;
            update-title := Text {
                y: 0;
                height: 32px;
                font-size: 24px;
                font-weight: 700;
                text: "Update available!";
                color: white;
            }
            update-current := Text {
                y: 44px;
                height: 20px;
                font-size: 14px;
                text: "Current version: " + root.version;
                color: Palette.rose-500;
            }
            update-new := Text {
                y: 64px;
                height: 20px;
                font-size: 14px;
                text: "New version: " + root.update-version;
                color: Palette.lime-500;
            }
            if !root.update-busy: Rectangle {
                y: 100px;
                height: 36px;
                Rectangle {
                    x: 0;
                    width: parent.width - 4px - 72px;
                    border-radius: 8px;
                    background: download-touch.has-hover ? #3f621280 : #3f62124d;
                    update-button-label := Text {
                        text: "Update";
                        color: white;
                    }
                    download-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.update-now();
                        }
                    }
                }
                Rectangle {
                    x: parent.width - 72px;
                    width: 72px;
                    border-radius: 8px;
                    background: later-touch.has-hover ? #9f123980 : #9f12394d;
                    later-label := Text {
                        text: "Later";
                        color: white;
                    }
                    later-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.update-later();
                        }
                    }
                }
            }
            if !root.update-busy && root.update-state == "": Rectangle {
                y: 140px;
                height: 16px;
                skip-label := Text {
                    font-size: 12px;
                    text: "Skip this version";
                    color: skip-touch.has-hover ? Palette.gray-400 : Palette.gray-500;
                }
                skip-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.update-skip();
                    }
                }
            }
            if root.update-state != "": update-state-label := Text {
                y: root.update-busy ? 104px : 140px;
                width: parent.width;
                height: 16px;
                font-size: 12px;
                horizontal-alignment: center;
                text: root.update-state;
                color: Palette.gray-400;
                overflow: elide;
            }
        }
    }

    if !root.update-shown: Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;

        nav-home := NavItem {
            x: 0;
            y: 0;
            text: "Home";
            active: root.page == 0;
            clicked => {
                root.page = 0;
            }
        }
        nav-settings := NavItem {
            x: 54px;
            y: 0;
            text: "Settings";
            active: root.page == 1;
            clicked => {
                root.page = 1;
            }
        }
        nav-about := NavItem {
            x: 125px;
            y: 0;
            text: "About";
            active: root.page == 2;
            clicked => {
                root.page = 2;
            }
        }

        main := Rectangle {
            y: 30px;
            height: parent.height - 30px;

            Home {
                visible: root.page == 0;
                connected: root.connected;
                bpm: root.bpm;
                percent-text: root.percent-text;
                status: root.status;
            }

            if root.page == 1: Rectangle {
                tabs := VerticalLayout {
                    x: 0;
                    y: 8px;
                    width: 98px;
                    spacing: 8px;
                    alignment: start;
                    SmallButton {
                        text: "General";
                        active: root.tab == "general";
                        clicked => {
                            root.tab = "general";
                        }
                    }
                    if root.show-bluetooth: SmallButton {
                        text: "Bluetooth";
                        active: root.tab == "bluetooth";
                        clicked => {
                            root.tab = "bluetooth";
                        }
                    }
                    if root.show-pico: SmallButton {
                        text: "Pico";
                        active: root.tab == "pico";
                        clicked => {
                            root.tab = "pico";
                        }
                    }
                    if root.show-http: SmallButton {
                        text: "HTTP";
                        active: root.tab == "http";
                        clicked => {
                            root.tab = "http";
                        }
                    }
                    if root.show-pulsoid: SmallButton {
                        text: "Pulsoid";
                        active: root.tab == "pulsoid";
                        clicked => {
                            root.tab = "pulsoid";
                        }
                    }
                    SmallButton {
                        text: "OSC";
                        active: root.tab == "osc";
                        clicked => {
                            root.tab = "osc";
                        }
                    }
                    SmallButton {
                        text: "Parameters";
                        active: root.tab == "parameters";
                        clicked => {
                            root.tab = "parameters";
                        }
                    }
                }

                content := Flickable {
                    x: 106px;
                    y: 8px;
                    width: 180px;
                    height: parent.height - 8px;
                    content-height: max(self.height, pane.preferred-height);
                    pane := VerticalLayout {
                        alignment: start;
                        spacing: 8px;

                        if root.tab == "general": VerticalLayout {
                            spacing: 8px;
                            Label {
                                text: "Service Type:";
                            }
                            Select {
                                options: root.services;
                                current <=> root.service;
                                picked(index) => {
                                    root.service-picked(index);
                                }
                            }
                            Rectangle {
                                height: 2px;
                            }
                            Label {
                                text: "Connected Timeout:";
                            }
                            Field {
                                number: true;
                                text <=> root.connected-timeout;
                                placeholder: "10";
                                edited(value) => {
                                    root.setting("connected_timeout", value);
                                }
                            }
                            Rectangle {
                                height: 2px;
                            }
                            Check {
                                text: "Start at login";
                                checked <=> root.autostart;
                                toggled(on) => {
                                    root.autostart-toggled(on);
                                }
                            }
                            if root.steamvr-supported: Check {
                                text: "Start with SteamVR";
                                checked <=> root.steamvr;
                                toggled(on) => {
                                    root.steamvr-toggled(on);
                                }
                            }
                            Check {
                                text: "Check for updates";
                                checked <=> root.check-updates;
                                toggled(on) => {
                                    root.updates-toggled(on);
                                }
                            }
                        }

                        if root.tab == "bluetooth": VerticalLayout {
                            spacing: 8px;
                            Label {
                                text: "Device:";
                            }
                            VerticalLayout {
                                spacing: 2px;
                                for device in root.devices: Rectangle {
                                    height: 24px;
                                    border-radius: 2px;
                                    background: device-touch.has-hover ? Palette.gray-800 : Palette.input;
                                    device-label := Text {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        height: parent.height;
                                        vertical-alignment: center;
                                        font-size: 14px;
                                        text: device.name;
                                        overflow: elide;
                                        color: device.selected ? Palette.cyan-400 : Palette.gray-400;
                                    }
                                    device-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.device-picked(device.address);
                                        }
                                    }
                                }
                            }
                            bt-status := Text {
                                font-size: 12px;
                                text: root.status;
                                color: Palette.gray-500;
                                wrap: word-wrap;
                            }
                        }

                        if root.tab == "pico": VerticalLayout {
                            spacing: 8px;
                            Label {
                                text: "Board:";
                            }
                            pico-board := Text {
                                font-size: 14px;
                                text: root.status == "" ? "Not in use" : root.status;
                                color: Palette.gray-400;
                                wrap: word-wrap;
                            }
                            Rectangle {
                                height: 2px;
                            }
                            Label {
                                text: "Strap Name (optional):";
                            }
                            Field {
                                text <=> root.pico-strap;
                                placeholder: "first strap found";
                                edited(value) => {
                                    root.setting("pico_strap_name", value);
                                }
                            }
                            SmallButton {
                                text: "Install Firmware";
                                clicked => {
                                    root.install-firmware();
                                }
                            }
                            pico-notice := Text {
                                font-size: 12px;
                                text: root.notice == "" ? "The board needs MicroPython first." : root.notice;
                                color: Palette.gray-500;
                                wrap: word-wrap;
                            }
                        }

                        if root.tab == "http": VerticalLayout {
                            spacing: 8px;
                            Label {
                                text: "HTTP Server Port:";
                            }
                            Field {
                                number: true;
                                text <=> root.http-port;
                                placeholder: "8080";
                                edited(value) => {
                                    root.setting("http_server_port", value);
                                }
                            }
                            Rectangle {
                                height: 2px;
                            }
                            SmallButton {
                                text: "Restart Server";
                                clicked => {
                                    root.restart-source();
                                }
                            }
                        }

                        if root.tab == "pulsoid": VerticalLayout {
                            spacing: 8px;
                            Label {
                                text: "Widget Id:";
                            }
                            Field {
                                text <=> root.widget-id;
                                edited(value) => {
                                    root.setting("stromno_widget_id", value);
                                }
                            }
                            Rectangle {
                                height: 2px;
                            }
                            SmallButton {
                                text: "Reconnect";
                                clicked => {
                                    root.restart-source();
                                }
                            }
                        }

                        if root.tab == "osc": VerticalLayout {
                            spacing: 8px;
                            Label {
                                text: "OSC Host:";
                            }
                            Field {
                                text <=> root.osc-host;
                                placeholder: "127.0.0.1";
                                edited(value) => {
                                    root.setting("osc_client_host", value);
                                }
                            }
                            Rectangle {
                                height: 2px;
                            }
                            Label {
                                text: "OSC Port:";
                            }
                            Field {
                                number: true;
                                text <=> root.osc-port;
                                placeholder: "9000";
                                edited(value) => {
                                    root.setting("osc_client_port", value);
                                }
                            }
                        }

                        if root.tab == "parameters": VerticalLayout {
                            spacing: 8px;
                            Label {
                                text: "Connected Parameter Path:";
                            }
                            Field {
                                text <=> root.path-connected;
                                edited(value) => {
                                    root.setting("osc_path_connected", value);
                                }
                            }
                            Rectangle {
                                height: 2px;
                            }
                            Label {
                                text: "HR Percent Parameter Path:";
                            }
                            Field {
                                text <=> root.path-percent;
                                edited(value) => {
                                    root.setting("osc_path_percent", value);
                                }
                            }
                            Rectangle {
                                height: 2px;
                            }
                            Label {
                                text: "Max Heart Rate:";
                            }
                            Field {
                                number: true;
                                text <=> root.max-heart-rate;
                                placeholder: "(default: 200)";
                                edited(value) => {
                                    root.setting("max_heart_rate", value);
                                }
                            }
                        }
                    }
                }
            }

            if root.page == 2: Rectangle {
                Image {
                    x: 16px;
                    y: 16px;
                    width: 48px;
                    height: 48px;
                    source: @image-url("../assets/icon.png");
                }
                about-title := Text {
                    x: 76px;
                    y: 14px;
                    height: 36px;
                    font-size: 30px;
                    text: "hr-osc-rust";
                    color: white;
                }
                about-version := Text {
                    x: 76px;
                    y: 51px;
                    height: 14px;
                    font-size: 16px;
                    vertical-alignment: center;
                    text: "version: " + root.version;
                    color: Palette.gray-500;
                }
                Link {
                    x: 16px;
                    y: 113px;
                    text: "GitHub";
                    clicked => {
                        root.open-link("https://github.com/RealWhyKnot/hr-osc-rust");
                    }
                }
                Link {
                    x: 16px;
                    y: 145px;
                    text: "Pico firmware guide";
                    clicked => {
                        root.open-link("https://github.com/RealWhyKnot/hr-osc-rust#pico-bridge");
                    }
                }
                Link {
                    x: 16px;
                    y: 165px;
                    text: "Inspired by hr-osc (kamyu1537)";
                    clicked => {
                        root.open-link("https://github.com/kamyu1537/hr-osc");
                    }
                }
            }
        }
    }
}
